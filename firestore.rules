rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(eventId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.memberIds;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid && request.auth.uid in request.resource.data.memberIds;
      // Um usuário autenticado precisa conseguir ler um convite pelo event_id.
      // A listagem do aplicativo é filtrada no cliente pelos eventos em que ele é membro.
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= resource.data.memberIds.size() + 1;
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;

      match /members/{userId} {
        allow read: if isMember(eventId);
        allow create, update: if signedIn() && request.auth.uid == userId && request.resource.data.name is string;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /attendances/{userId} {
        allow read: if isMember(eventId);
        allow create: if signedIn() && request.auth.uid == userId && request.resource.data.keys().hasOnly(['userName', 'confirmedAt']);
        allow update, delete: if false;
      }
    }
  }
}
